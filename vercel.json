{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/**/*.ts": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/kwikpay-proxy/(.*)",
            "destination": "https://kwikpay.web.tr/$1"
        },
        {
            "source": "/api/lowtrack-proxy",
            "destination": "https://lowtrack.com.br/api/webhook"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}